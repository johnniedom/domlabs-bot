# domlabs-bot configuration.
# Copy to ~/.domlabs-bot/.env and fill in. `domlabs-bot init` does this for you.

# --- Required ---

# Anthropic API key. Used by the Claude Agent SDK for the Claude Code runtime.
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Numeric Telegram user ID of the single owner allowed to use the bot.
# All non-owner messages are silently dropped.
OWNER_USER_ID=

# --- Optional ---

# Default working directory the agent starts in. Defaults to your home dir.
# DEFAULT_CWD=

# Idle minutes before a project session is recycled (and auto-summarized).
IDLE_TIMEOUT_MINUTES=15

# Override the Anthropic model used. The wizard sets this in step 2.
# MODEL=claude-sonnet-4-6

# Override path to the Claude Code CLI binary.
# Leave blank to autodetect on PATH.
# CLAUDE_CLI_PATH=

# --- Voice (optional) ---
# Set to "true" to enable voice transcription + TTS replies.
# Requires `pip install 'domlabs-bot[voice]'`.
VOICE_ENABLED=false

# Gemini API key — used for both transcription and TTS when VOICE_ENABLED=true.
# GEMINI_API_KEY=

# Override domlabs-bot's data root (persona, projects, memory, logs).
# Defaults to ~/.domlabs-bot/.
# DOMLABS_BOT_ROOT=
